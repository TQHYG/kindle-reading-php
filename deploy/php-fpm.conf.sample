; Kykky 2.0 PHP-FPM pool 示例
; 放到 /etc/php-fpm.d/kykky.conf（Fedora）或 /etc/php/8.x/fpm/pool.d/kykky.conf（Debian）
; 注意：user/group 必须能读取项目文件，并能写 storage.path。

[kykky]
user = apache
group = apache

listen = /run/php-fpm/kykky.sock
listen.owner = nginx
listen.group = nginx
listen.mode = 0660

pm = dynamic
pm.max_children = 20
pm.start_servers = 3
pm.min_spare_servers = 2
pm.max_spare_servers = 8

php_admin_value[error_log] = /var/log/php-fpm/kykky-error.log
php_admin_flag[log_errors] = on
php_admin_flag[display_errors] = off
php_value[upload_max_filesize] = 25M
php_value[post_max_size] = 32M

; 可选：显式指定配置文件路径
; env[KYKKY_CONFIG] = /var/www/kindle-reading-php/config.php
